---
import type { PageId } from '../content/schema';
import { crossPageHref, otherPages } from '../lib/pages';

interface Props {
  eventId: string;
  current: PageId;
}

const { eventId, current } = Astro.props;
const others = otherPages(current);
---

<nav class="perspective" aria-label="Read this moment from another perspective">
  <p class="label perspective__label">See this moment from</p>
  <ul class="perspective__list">
    {
      others.map((page) => (
        <li>
          <a class="perspective__link" href={crossPageHref(page.id, eventId)}>
            <span class="perspective__name">{page.nav}</span>
            <span class="perspective__noun">{page.perspectiveNoun}</span>
            <span class="perspective__arrow" aria-hidden="true">
              →
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .perspective {
    padding: 0.9rem 1rem 0.95rem;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 4px;
  }

  .perspective__label {
    margin-bottom: 0.6rem;
  }

  .perspective__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
  }

  .perspective__link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--rule-strong);
    border-radius: 2px;
    text-decoration: none;
    color: var(--text-2);
    transition: border-color 140ms ease, color 140ms ease;
  }

  .perspective__link:hover {
    border-color: var(--accent-line);
    color: var(--text-1);
  }

  .perspective__name {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .perspective__noun {
    font-size: 0.8125rem;
  }

  .perspective__arrow {
    font-size: 0.8125rem;
    color: var(--text-faint);
  }

  @media (max-width: 600px) {
    .perspective__list {
      flex-direction: column;
      align-items: stretch;
    }

    .perspective__link {
      justify-content: space-between;
    }
  }
</style>
