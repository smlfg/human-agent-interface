---
import type { PageId } from '../content/schema';
import { chapters, events } from '../content/events';
import { NAV_IDS, PAGES, pageHref, pagePath } from '../lib/pages';
import { DOC_BASE } from '../lib/paths';
import { buildGroups } from '../lib/timeline';
import EventCard from './EventCard.astro';

interface Props {
  pageId: PageId;
}

const { pageId } = Astro.props;
const groups = buildGroups(events, chapters);
const total = events.length;

let counter = 0;
const rendered = groups.map((group) => {
  const items = group.events.map((event) => {
    counter += 1;
    return { event, index: counter - 1 };
  });
  return { chapter: group.chapter, items };
});
---

<div class="tl" data-timeline data-doc-base={DOC_BASE} data-page={pageId} data-total={total}>
  <div class="tl__status" data-status>
    <span class="tl__status-count mono" data-status-count>01 / {String(total).padStart(2, '0')}</span>
    <span class="tl__status-kicker" data-status-kicker>Reading position</span>
    <nav class="tl__perspectives" aria-label="Switch perspective at current moment">
      {
        NAV_IDS.map((id) => (
          <a
            class="tl__perspective-link"
            href={pageHref(id)}
            data-perspective-link
            data-page={id}
            data-path={pagePath(id)}
            aria-current={(pageId === id || (id === 'learnings' && pageId === 'retro')) ? 'page' : undefined}
          >
            {PAGES[id].nav}
          </a>
        ))
      }
    </nav>
    <span class="tl__status-bar" aria-hidden="true"><span data-progress-bar></span></span>
  </div>

  {
    rendered.map((group) => (
      <section
        class="tl-chapter"
        id={group.chapter ? `chapter-${group.chapter.id}` : undefined}
        aria-labelledby={group.chapter ? `chapter-${group.chapter.id}-title` : undefined}
      >
        <header class="tl-chapter__head">
          <div class="tl-chapter__rail" aria-hidden="true">
            <span class="tl-chapter__tick" />
          </div>
          <div class="tl-chapter__text">
            <p class="tl-chapter__date label">{group.chapter ? group.chapter.date : 'Unfiled'}</p>
            <h2 class="tl-chapter__title" id={group.chapter ? `chapter-${group.chapter.id}-title` : undefined}>
              {group.chapter ? group.chapter.title : 'Not yet filed'}
            </h2>
            <p class="tl-chapter__lede">
              {group.chapter
                ? group.chapter.lede
                : 'Events that no chapter claims yet — they still belong to the chronology.'}
            </p>
          </div>
        </header>

        <ol class="tl-events">
          {group.items.map((item) => (
            <li class="tl-event" data-event-id={item.event.id} data-state="future">
              <div class="tl-event__rail">
                <a class="tl-marker" href={`#${item.event.id}`} aria-label={`Jump to: ${item.event.title}`}>
                  <span class="tl-marker__dot" aria-hidden="true" />
                </a>
              </div>
              <EventCard event={item.event} pageId={pageId} index={item.index} total={total} />
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</div>

<style>
  .tl {
    position: relative;
  }

  .tl__status {
    position: sticky;
    top: 0;
    z-index: 6;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.6rem 0 0.55rem;
    margin-bottom: 0.5rem;
    background: linear-gradient(to bottom, var(--bg) 72%, rgba(11, 11, 12, 0.92) 100%);
    backdrop-filter: blur(6px);
  }

  .tl__status-count {
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    color: var(--accent);
  }

  .tl__status-kicker {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.8125rem;
    color: var(--text-2);
  }

  .tl__status-bar {
    position: relative;
    flex: none;
    width: 92px;
    height: 2px;
    background: var(--rule);
  }

  .tl__status-bar > span {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0%;
    background: var(--accent);
    transition: width 180ms linear;
  }

  .tl__perspectives {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    flex: none;
  }

  .tl__perspective-link {
    display: inline-block;
    padding: 0.16rem 0.45rem;
    border: 1px solid var(--rule);
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text-3);
    transition: color 140ms ease, border-color 140ms ease, background 140ms ease;
  }

  .tl__perspective-link:hover {
    color: var(--text-1);
    border-color: var(--rule-strong);
  }

  .tl__perspective-link[aria-current='page'] {
    color: var(--accent);
    border-color: var(--accent-line);
    background: var(--accent-soft);
  }

  .tl-chapter {
    margin-bottom: 3.25rem;
  }

  .tl-chapter__head {
    display: grid;
    grid-template-columns: var(--gutter) minmax(0, 1fr);
    column-gap: var(--rail-gap);
    align-items: start;
    padding-top: 1.5rem;
  }

  .tl-chapter__rail {
    display: flex;
    justify-content: center;
    padding-top: 0.55rem;
  }

  .tl-chapter__tick {
    width: 7px;
    height: 7px;
    border: 1px solid var(--text-faint);
    transform: rotate(45deg);
  }

  .tl-chapter__text {
    max-width: 62ch;
  }

  .tl-chapter__date {
    color: var(--text-3);
  }

  .tl-chapter__title {
    margin-top: 0.3rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.2;
    color: var(--text-1);
  }

  .tl-chapter__lede {
    margin-top: 0.45rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-2);
  }

  .tl-events {
    display: flex;
    flex-direction: column;
  }

  .tl-event {
    display: grid;
    grid-template-columns: var(--gutter) minmax(0, 1fr);
    column-gap: var(--rail-gap);
    padding-bottom: 1.35rem;
  }

  .tl-event__rail {
    position: relative;
    display: flex;
    justify-content: center;
  }

  /* The continuous hairline of the chronology. Chapters interrupt it. */
  .tl-event__rail::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    transform: translateX(-0.5px);
    background: var(--rule-strong);
    transition: background 260ms ease;
  }

  .tl-event:last-child .tl-event__rail::before {
    bottom: auto;
    height: 1.35rem;
  }

  .tl-event[data-state='passed'] .tl-event__rail::before {
    background: var(--accent-line);
  }

  .tl-marker {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    margin-top: 0.65rem;
    border-radius: 50%;
    z-index: 1;
  }

  .tl-marker:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .tl-marker__dot {
    width: 9px;
    height: 9px;
    border: 1px solid var(--text-faint);
    border-radius: 50%;
    background: var(--bg);
    transition:
      transform 180ms ease,
      background 200ms ease,
      border-color 200ms ease,
      box-shadow 200ms ease;
  }

  .tl-marker:hover .tl-marker__dot {
    border-color: var(--accent);
  }

  .tl-event[data-state='current'] .tl-marker__dot,
  .tl-marker[aria-current='location'] .tl-marker__dot,
  .tl-marker[aria-current='true'] .tl-marker__dot {
    background: var(--accent);
    border-color: var(--accent);
    transform: scale(1.2);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .tl-event[data-state='passed'] .tl-marker__dot {
    border-color: var(--accent-line);
  }

  @media (max-width: 900px) {
    .tl__status-kicker {
      display: none;
    }

    .tl__status-count {
      margin-right: auto;
    }

    .tl-chapter__title {
      font-size: 1.3125rem;
    }
  }

  @media (max-width: 600px) {
    .tl__status {
      padding: 0.5rem 0 0.45rem;
      gap: 0.5rem;
    }

    .tl__status-bar {
      display: none;
    }

    .tl__perspective-link {
      padding: 0.14rem 0.36rem;
      font-size: 0.5625rem;
      letter-spacing: 0.09em;
    }

    .tl-chapter__head {
      padding-top: 1.1rem;
    }

    .tl-event {
      padding-bottom: 1.1rem;
    }
  }
</style>
