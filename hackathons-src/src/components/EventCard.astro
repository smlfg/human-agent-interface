---
import type { PageId, TimelineEvent } from '../content/schema';
import { formatDate, significanceFor } from '../lib/timeline';
import ArchDiagram from './ArchDiagram.astro';
import EvidenceBadge from './EvidenceBadge.astro';
import LearningFrame from './LearningFrame.astro';
import LearningsCollapsedHeaderDemo from './LearningsCollapsedHeaderDemo.astro';
import LearningsDatasetShiftDemo from './LearningsDatasetShiftDemo.astro';
import LearningsRouterExplorer from './LearningsRouterExplorer.astro';
import MetricList from './MetricList.astro';
import PerspectiveSwitch from './PerspectiveSwitch.astro';
import QuoteBlock from './QuoteBlock.astro';
import SourceList from './SourceList.astro';

interface Props {
  event: TimelineEvent;
  pageId: PageId;
  index: number;
  total: number;
}

const { event, pageId, index, total } = Astro.props;
const reading = significanceFor(event, pageId);
const isStory = pageId === 'story';
const isLearnings = pageId === 'learnings';

const dateText = formatDate(event.date);
const exactTime = event.timeConfidence === 'exact' && event.time;
const timeText = event.time
  ? event.timeConfidence === 'exact'
    ? event.time
    : `≈ ${event.time}`
  : null;

const FEATURE_LABEL: Record<string, string> = {
  breakthrough: 'breakthrough',
  reversal: 'reversal',
  failure: 'failure',
  question: 'open question',
};

const READING_LABEL: Record<PageId, string> = {
  tech: 'Technical reading',
  learnings: 'In one line',
  story: 'The narrative',
  retro: 'Retrospective critique',
};
---

<article class="card" id={event.id} data-event-id={event.id} data-page={pageId} tabindex="-1">
  <header class="card__head">
    <p class="card__meta">
      <span class="card__kicker label">{event.kicker}</span>
      <span class="card__date mono" data-confidence={event.timeConfidence}>
        <span class="card__day">{dateText}</span>
        {timeText ? <span class="card__sep" aria-hidden="true">·</span> : null}
        {timeText ? <span class="card__time">{timeText}</span> : null}
        {!exactTime ? (
          <span class="sr-only">
            {event.time ? 'Approximate time.' : 'Exact time of day not recorded.'}
          </span>
        ) : null}
      </span>
      {event.feature && event.feature !== 'none' ? (
        <span class="card__feature" data-feature={event.feature}>
          {FEATURE_LABEL[event.feature] ?? event.feature}
        </span>
      ) : null}
      <EvidenceBadge status={event.evidence} />
    </p>

    <h3 class="card__title">{event.title}</h3>

    {
      isStory ? (
        <>
          <p class="card__narrative">{reading}</p>
          <p class="card__summary card__summary--story">{event.summary}</p>
        </>
      ) : (
        <p class="card__summary">{event.summary}</p>
      )
    }
  </header>

  {
    isLearnings && event.id === 'ev-2026-11-21-collapsed-header' ? (
      <LearningsCollapsedHeaderDemo />
    ) : null
  }
  {
    isLearnings && event.id === 'ev-2026-11-21-lexicon-sign-flip' ? (
      <LearningsDatasetShiftDemo />
    ) : null
  }
  {
    isLearnings && event.id === 'ev-2026-11-21-decision-tree-result' ? (
      <LearningsRouterExplorer />
    ) : null
  }

  <button
    class="card__toggle"
    type="button"
    aria-expanded="false"
    aria-controls={`detail-${event.id}`}
    data-toggle
  >
    <span class="card__toggle-text" data-label-open="Read this moment" data-label-close="Close">
      Read this moment
    </span>
    <span class="card__chevron" aria-hidden="true"></span>
  </button>

  <div class="card__detail" id={`detail-${event.id}`} data-detail data-open="false">
    <div class="card__detail-inner">
      {
        !isStory ? (
          <div class="card__section">
            <p class="label card__section-label">{READING_LABEL[pageId]}</p>
            <p class="card__reading">{reading}</p>
          </div>
        ) : null
      }

      {
        isLearnings ? (
          <div class="card__section">
            <p class="label card__section-label">The frame</p>
            {event.learning ? (
              <LearningFrame frame={event.learning} />
            ) : (
              <p class="card__fallback">
                No learning frame was recorded for this event — the pre-event assumption and the
                corrected model were never written down.
              </p>
            )}
          </div>
        ) : null
      }

      {
        event.metrics && event.metrics.length > 0 && !isStory ? (
          <div class="card__section">
            <p class="label card__section-label">Measurements</p>
            <MetricList metrics={event.metrics} eventStatus={event.evidence} />
          </div>
        ) : null
      }

      {
        event.diagram ? (
          <div class="card__section">
            <ArchDiagram diagram={event.diagram} idBase={`diag-${event.id}`} />
          </div>
        ) : null
      }

      {
        event.quotes && event.quotes.length > 0 ? (
          <div class="card__section">
            <p class="label card__section-label">From the notes</p>
            <QuoteBlock quotes={event.quotes} />
          </div>
        ) : null
      }

      {
        event.commits && event.commits.length > 0 ? (
          <div class="card__section">
            <p class="label card__section-label">Commits</p>
            <ul class="hashes">
              {event.commits.map((hash) => (
                <li class="hashes__item mono">{hash}</li>
              ))}
            </ul>
          </div>
        ) : null
      }

      {
        event.branches && event.branches.length > 0 ? (
          <div class="card__section">
            <p class="label card__section-label">Branches</p>
            <ul class="hashes">
              {event.branches.map((branch) => (
                <li class="hashes__item mono">{branch}</li>
              ))}
            </ul>
          </div>
        ) : null
      }

      {
        event.sources.length > 0 ? (
          <div class="card__section">
            <p class="label card__section-label">Sources</p>
            <SourceList sources={event.sources} />
          </div>
        ) : null
      }

      {
        event.unresolved && event.unresolved.length > 0 ? (
          <div class="card__section">
            <p class="label card__section-label">Still open</p>
            <ul class="open">
              {event.unresolved.map((item) => (
                <li class="open__item">{item}</li>
              ))}
            </ul>
          </div>
        ) : null
      }

      <div class="card__section">
        <PerspectiveSwitch eventId={event.id} current={pageId} />
      </div>

      <p class="card__position mono" aria-hidden="true">
        {String(index + 1).padStart(2, '0')} / {String(total).padStart(2, '0')}
      </p>
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
    min-width: 0;
    max-width: 100%;
    scroll-margin-top: 96px;
    padding: 1.05rem 1.15rem 1rem;
    background: var(--card);
    border: 1px solid var(--rule);
    border-radius: 4px;
    transition: border-color 200ms ease;
  }

  .card:hover {
    border-color: var(--rule-strong);
  }

  .card:focus {
    outline: none;
  }

  .card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .card::before {
    content: '';
    position: absolute;
    left: -1px;
    top: 0.95rem;
    bottom: 0.95rem;
    width: 2px;
    background: transparent;
    transition: background 220ms ease;
  }

  .card[data-current='true']::before {
    background: var(--accent);
  }

  .card__head {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.7rem;
  }

  .card__kicker {
    color: var(--accent);
  }

  .card__date {
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--text-3);
    text-transform: uppercase;
  }

  .card__date[data-confidence='approx'],
  .card__date[data-confidence='day'],
  .card__date[data-confidence='range'] {
    text-decoration: underline dotted var(--text-faint);
    text-underline-offset: 3px;
  }

  .card__sep {
    margin: 0 0.35em;
    color: var(--text-faint);
  }

  .card__time {
    color: var(--text-2);
  }

  .card__feature {
    padding: 0.12rem 0.42rem;
    border: 1px solid var(--rule-strong);
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .card__feature[data-feature='breakthrough'] {
    color: #86cfa3;
    border-color: rgba(134, 207, 163, 0.4);
  }

  .card__feature[data-feature='reversal'] {
    color: #e8b87f;
    border-color: rgba(232, 184, 127, 0.4);
  }

  .card__feature[data-feature='failure'] {
    color: #e88c8c;
    border-color: rgba(232, 140, 140, 0.4);
  }

  .card__feature[data-feature='question'] {
    color: #b9a7e0;
    border-color: rgba(185, 167, 224, 0.4);
  }

  .card__title {
    font-family: var(--font-display);
    font-size: 1.3125rem;
    line-height: 1.3;
    letter-spacing: -0.005em;
    color: var(--text-1);
  }

  .card__summary {
    max-width: var(--measure);
    font-size: 0.9375rem;
    line-height: 1.62;
    color: var(--text-2);
  }

  .card__summary--story {
    font-size: 0.875rem;
    color: var(--text-3);
  }

  .card__narrative {
    max-width: 58ch;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--text-1);
  }

  .card__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.85rem;
    padding: 0.28rem 0.55rem 0.28rem 0.7rem;
    border: 1px solid var(--rule-strong);
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--text-2);
    transition: color 140ms ease, border-color 140ms ease;
  }

  .card__toggle:hover {
    color: var(--accent);
    border-color: var(--accent-line);
  }

  .card__chevron {
    position: relative;
    width: 0.5rem;
    height: 0.5rem;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: rotate(45deg) translate(-1px, -1px);
    transition: transform 220ms ease;
  }

  .card__toggle[aria-expanded='true'] .card__chevron {
    transform: rotate(-135deg) translate(-2px, -2px);
  }

  .card__detail {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    visibility: hidden;
    transition:
      grid-template-rows 340ms cubic-bezier(0.22, 0.7, 0.24, 1),
      opacity 240ms ease,
      visibility 0s linear 340ms;
  }

  .card__detail[data-open='true'] {
    grid-template-rows: 1fr;
    opacity: 1;
    visibility: visible;
    transition:
      grid-template-rows 340ms cubic-bezier(0.22, 0.7, 0.24, 1),
      opacity 240ms ease,
      visibility 0s;
  }

  .card__detail[data-instant='true'] {
    transition: none;
  }

  .card__detail-inner {
    overflow: hidden;
    min-width: 0;
    min-height: 0;
  }

  .card__section {
    padding-top: 1.05rem;
    margin-top: 1.05rem;
    border-top: 1px solid var(--rule);
  }

  .card__section-label {
    display: block;
    margin-bottom: 0.6rem;
  }

  .card__reading {
    max-width: var(--measure);
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-1);
    padding-left: 0.85rem;
    border-left: 1px solid var(--accent-line);
  }

  .card__reading[data-variant='narrative'] {
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1.62;
  }

  .card__fallback {
    max-width: var(--measure);
    padding: 0.8rem 0.9rem;
    background: var(--surface);
    border: 1px dashed var(--rule-strong);
    border-radius: 3px;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-3);
  }

  .hashes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .hashes__item {
    max-width: 100%;
    padding: 0.16rem 0.45rem;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 2px;
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--text-2);
    overflow-wrap: anywhere;
  }

  .open {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    max-width: var(--measure);
  }

  .open__item {
    position: relative;
    padding-left: 1rem;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-2);
  }

  .open__item::before {
    content: '?';
    position: absolute;
    left: 0;
    top: 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-faint);
  }

  .card__position {
    margin-top: 1.15rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--rule);
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    color: var(--text-faint);
    text-align: right;
  }

  @media (max-width: 600px) {
    .card {
      padding: 0.9rem 0.85rem 0.85rem;
    }

    .card__title {
      font-size: 1.1875rem;
    }
  }
</style>
