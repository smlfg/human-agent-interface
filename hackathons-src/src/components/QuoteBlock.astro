---
import type { Quote } from '../content/schema';

interface Props {
  quotes: Quote[];
}

const { quotes } = Astro.props;
---

<div class="quotes">
  {
    quotes.map((quote) => (
      <figure class="quote">
        <blockquote>
          <p>{quote.text}</p>
        </blockquote>
        <figcaption>
          <span class="quote__context">{quote.context}</span>
          <span class="quote__source mono">{quote.source}</span>
        </figcaption>
      </figure>
    ))
  }
</div>

<style>
  .quotes {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .quote {
    margin: 0;
    padding-left: 1.05rem;
    border-left: 1px solid var(--rule-strong);
  }

  blockquote {
    margin: 0;
  }

  blockquote p {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--text-1);
  }

  figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-top: 0.55rem;
  }

  .quote__context {
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: var(--text-3);
  }

  .quote__source {
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--text-faint);
    word-break: break-word;
  }
</style>
