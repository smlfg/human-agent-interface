---
import { hackathons } from '../content/hackathons';
import { archiveHref, HOME_HREF } from '../lib/paths';

const entries = [...hackathons].sort((a, b) => b.isoDate.localeCompare(a.isoDate));
const base = import.meta.env.BASE_URL;
const title = 'Hackathons — Samuel Fleig';
const description =
  'An archive of hackathon experiments by Samuel Fleig: what was built, what was measured, and what changed in understanding.';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Hackathons',
  url: canonical,
  author: { '@type': 'Person', name: 'Samuel Fleig', url: 'https://www.human-agent-interface.com/samuel/' },
  hasPart: entries.map((e) => ({
    '@type': 'CreativeWork',
    name: e.project,
    url: new URL(e.href ?? '', canonical).href,
    datePublished: e.isoDate,
  })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#090a08" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href={`${base}favicon.png`} type="image/png" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="topbar">
      <div class="topbar-inner">
        <a class="mark" href="/" aria-label="Back to Human Agent Interface home"><span class="mark-symbol">SF</span><span>About Samuel</span></a>
        <nav class="nav" aria-label="Site navigation">
          <a href="/what_it_is/">Method</a>
          <a href="/fit/">Fit</a>
          <a href="/proof/">Proof</a>
          <a href={HOME_HREF}>Samuel</a>
          <a href={archiveHref()} aria-current="page">Hackathons</a>
          <a href="/product/">Offer</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={HOME_HREF}>Samuel Fleig</a> <span aria-hidden="true">/</span> <span aria-current="page">Hackathons</span>
      </nav>
      <p class="eyebrow">Experiments · collaboration · engineering · learning</p>
      <h1>Hackathons</h1>
      <p class="lede">
        An archive of short, intense builds. Not certificates or awards — what was tried, what the
        measurements showed, and what changed in my understanding. Each entry links to the full story.
      </p>

      <ul class="entries">
        {
          entries.map((e) => (
            <li class="entry">
              <article aria-labelledby={`h-${e.slug}`}>
                <p class="meta">{e.dates} · {e.location} · {e.organizer}</p>
                <h2 id={`h-${e.slug}`}>
                  {e.href ? <a href={`${base}${e.href}`}>{e.project}</a> : e.project}
                </h2>
                <p class="sub">{e.name}</p>
                <p>{e.challenge}</p>
                <dl>
                  <div><dt>My role</dt><dd>{e.role}</dd></div>
                  {e.collaborators && <div><dt>Collaborators</dt><dd>{e.collaborators}</dd></div>}
                  <div><dt>Outcome</dt><dd>{e.outcome}</dd></div>
                  <div><dt>Evidence</dt><dd>{e.evidenceStatus}</dd></div>
                  <div><dt>Key learning</dt><dd>{e.keyLearning}</dd></div>
                </dl>
                <ul class="tags" aria-label="Technologies explored">
                  {e.technologies.map((t) => <li>{t}</li>)}
                </ul>
                <p class="actions">
                  {e.href && (
                    <a class="button primary" href={`${base}${e.href}`}>Read the full project story →</a>
                  )}
                  {e.href && (
                    <>
                      <a class="button" href={`${base}${e.href}story/`}>Story</a>
                      <a class="button" href={`${base}${e.href}tech/`}>Tech</a>
                      <a class="button" href={`${base}${e.href}learnings/`}>Learnings</a>
                    </>
                  )}
                  {(e.links ?? []).map((l) => <a class="button" href={l.href} rel="noopener noreferrer">{l.label} ↗</a>)}
                </p>
              </article>
            </li>
          ))
        }
      </ul>
    </main>
    <footer class="foot"><a href={HOME_HREF}>← Back to Samuel Fleig</a></footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --ink: #f5efdf; --muted: #b9ad95; --quiet: #766d5e; --black: #080806;
    --line: rgba(245, 239, 223, 0.16); --gold: #e6a83a; --green: #a7ff4f;
    --display: "Iowan Old Style", "Palatino Linotype", Georgia, serif;
    --body: "Neue Haas Grotesk Text", "Aptos", "Segoe UI", sans-serif;
  }
  * { box-sizing: border-box; }
  body { margin: 0; min-width: 320px; background: var(--black); color: var(--ink); font-family: var(--body); line-height: 1.6; }
  a { color: inherit; }
  .skip-link { position: absolute; left: -999px; } .skip-link:focus { left: 8px; top: 8px; background: var(--gold); color: #000; padding: 6px 10px; z-index: 10; }
  .topbar { border-bottom: 1px solid var(--line); }
  .topbar-inner { max-width: 1180px; margin: 0 auto; padding: 14px clamp(18px, 4vw, 56px); display: flex; flex-wrap: wrap; gap: 12px 24px; justify-content: space-between; align-items: center; }
  .mark { display: flex; gap: 10px; align-items: center; text-decoration: none; font-weight: 600; }
  .mark-symbol { display: grid; place-items: center; width: 32px; height: 32px; border: 1px solid var(--gold); color: var(--gold); font-size: 13px; }
  .nav { display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: 14px; }
  .nav a { color: var(--muted); text-decoration: none; } .nav a:hover { color: var(--ink); }
  .nav a[aria-current="page"] { color: var(--green); }
  main { max-width: 900px; margin: 0 auto; padding: 28px clamp(18px, 4vw, 56px) 64px; }
  .crumbs { font-size: 13px; color: var(--quiet); } .crumbs a { color: var(--muted); }
  .eyebrow { margin: 36px 0 0; color: var(--gold); font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase; }
  h1 { font-family: var(--display); font-weight: 400; font-size: clamp(2.4rem, 7vw, 4rem); line-height: 1.05; margin: 8px 0 12px; }
  .lede { max-width: 60ch; color: var(--muted); font-size: 1.1rem; }
  .entries { list-style: none; padding: 0; margin: 40px 0 0; display: grid; gap: 24px; }
  .entry article { border: 1px solid var(--line); background: rgba(245, 239, 223, 0.06); padding: clamp(18px, 3vw, 32px); }
  .meta { margin: 0; color: var(--gold); font-size: 13px; letter-spacing: 0.04em; }
  .entry h2 { font-family: var(--display); font-weight: 400; font-size: 2rem; margin: 6px 0 0; }
  .entry h2 a { text-decoration: none; } .entry h2 a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .sub { margin: 2px 0 14px; color: var(--quiet); font-size: 14px; }
  dl { margin: 18px 0; display: grid; gap: 10px; }
  dl div { display: grid; grid-template-columns: 9rem 1fr; gap: 12px; border-top: 1px solid var(--line); padding-top: 10px; }
  dt { color: var(--quiet); font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em; } dd { margin: 0; }
  .tags { list-style: none; padding: 0; margin: 0 0 18px; display: flex; flex-wrap: wrap; gap: 8px; }
  .tags li { border: 1px solid var(--line); padding: 2px 10px; font-size: 13px; color: var(--muted); }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin: 0; }
  .button { display: inline-block; border: 1px solid var(--line); padding: 8px 14px; text-decoration: none; font-size: 14px; }
  .button:hover { border-color: var(--gold); }
  .button.primary { background: var(--gold); color: #0b0a07; border-color: var(--gold); font-weight: 600; }
  .foot { max-width: 900px; margin: 0 auto; padding: 0 clamp(18px, 4vw, 56px) 48px; }
  :focus-visible { outline: 2px solid var(--green); outline-offset: 3px; }
  @media (max-width: 600px) { dl div { grid-template-columns: 1fr; gap: 2px; } }
</style>
