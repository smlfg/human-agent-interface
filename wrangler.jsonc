{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "human-agent-interface",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-13",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/intake",
      "/intake/*",
      "/api/*"
    ]
  },
  "r2_buckets": [
    {
      "binding": "HAI_CLIENT_HANDOFFS",
      "bucket_name": "hai-client-handoffs",
      "jurisdiction": "eu",
      "preview_bucket_name": "hai-client-handoffs-preview"
    }
  ],
  "services": [
    {
      "binding": "EXPLAIN",
      "service": "cwh-11-explain-20261008",
      "remote": true
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "HAI_SITE_EVENTS",
      "dataset": "hai_site_events"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
